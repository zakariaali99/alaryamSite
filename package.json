{
  "name": "our-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.js && vite-react-ssg build && node scripts/generate-404.js",
    "preview": "vite preview",
    "check:gradients": "! grep -rniE \"gradient|bg-clip-text|\\bfrom-|\\bvia-|backdrop-blur|\\bblur-|drop-shadow-|filter:\\s*blur\" src",
    "check:i18n": "node scripts/check-i18n.js",
    "check:hex": "node scripts/check-hex.js",
    "check:links": "node scripts/check-links.js",
    "check:classes": "node scripts/check-classes.js",
    "package": "node scripts/package-release.js"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.1.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite-react-ssg": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "puppeteer-core": "^24.4.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
